app:
  name: Elo Ranking System
  club_name: My Dart Club
  environment: development
  debug: true
  timezone: Europe/Berlin
  # Date format for display. Options:
  #   dd/MM/yyyy  (default, e.g. 25/07/2026)
  #   MM/dd/yyyy  (e.g. 07/25/2026)
  #   yyyy-MM-dd  (e.g. 2026-07-25)
  #   dd.MM.yyyy  (e.g. 25.07.2026)
  date_format: dd/MM/yyyy
  base_url: ""  # Public URL for QR code behind reverse proxy, e.g. https://darts.example.com

elo:
  default_rating: 1200
  k_factor: 32

ranking:
  inactivity_months: 3

statistics:
  high_finish_min: 100
  high_finish_max: 170
  low_darts_min: 9
  low_darts_max: 21
  best_of_legs: 5  # Must be odd: 1, 3, 5, 7, 9...

legal:
  contact_company: Company
  contact_name: Max Mustermann
  contact_street: Musterstrasse 1
  contact_city: 11111 Musterstadt
  contact_email: max.Mustermann@Muster.mu

system_user:
  username: system
  password: change_me

security:
  jwt_secret: change_me  # CHANGE THIS IN PRODUCTION! Generate with: openssl rand -hex 32
  jwt_algorithm: HS256
  access_token_lifetime_minutes: 480
  cookie_secure: true  # Set to false for local HTTP development
  cookie_httponly: true
  cookie_samesite: strict  # Use 'lax' for local development if needed

storage:
  data_dir: /data
  upload_dir: /uploads
  log_dir: /logs
