# Application
APP_NAME=Elo Ranking System
CLUB_NAME=My Dart Club
APP_ENV=development
APP_DEBUG=false
CONFIG_PATH=/app/config.yaml
TIMEZONE=Europe/Berlin

# Date format for display (dd/MM/yyyy, MM/dd/yyyy, yyyy-MM-dd, dd.MM.yyyy)
DATE_FORMAT=dd/MM/yyyy

# Database
DATABASE_URL=sqlite:///./data/database.db
# For Docker: DATABASE_URL=sqlite:////data/database.db

# Elo Rating
DEFAULT_ELO=1200
K_FACTOR=32

# Ranking
INACTIVITY_MONTHS=3

# Statistics Validation
HIGH_FINISH_MIN=100
HIGH_FINISH_MAX=170
LOW_DARTS_MIN=9
LOW_DARTS_MAX=21

# Legal / Impressum
CONTACT_COMPANY=Company
CONTACT_NAME=Max Mustermann
CONTACT_STREET=Musterstrasse 1
CONTACT_CITY=11111 Musterstadt
CONTACT_EMAIL=max.Mustermann@Muster.mu

# System User - CHANGE PASSWORD IN PRODUCTION
SYSTEM_USER_USERNAME=system
SYSTEM_USER_PASSWORD=change_me

# Security - CHANGE THESE IN PRODUCTION
JWT_SECRET=change_me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_LIFETIME_MINUTES=480
COOKIE_SECURE=true
COOKIE_HTTPONLY=true
COOKIE_SAMESITE=strict

# Storage
DATA_DIR=./data
UPLOAD_DIR=./uploads
LOG_DIR=./logs
BACKUP_DIR=./backups