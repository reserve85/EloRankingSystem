# Application
APP_NAME=Elo Ranking System
CLUB_NAME=My Dart Club
APP_ENV=development
APP_DEBUG=true

# Configuration file path
CONFIG_PATH=config.yaml

# Database
DATABASE_URL=sqlite:///./data/database.db
# For Docker: DATABASE_URL=sqlite:////data/database.db

# Elo Rating
DEFAULT_ELO=1200
K_FACTOR=32

# Ranking
INACTIVITY_MONTHS=3

# System User - CHANGE PASSWORD IN PRODUCTION
SYSTEM_USER_USERNAME=system
SYSTEM_USER_PASSWORD=change_me

# Security - CHANGE THESE IN PRODUCTION
JWT_SECRET=change_me_to_a_random_secret_key
JWT_ALGORITHM=HS256
ACCESS_TOKEN_LIFETIME_MINUTES=480
COOKIE_SECURE=false
COOKIE_HTTPONLY=true
COOKIE_SAMESITE=lax

# Storage
DATA_DIR=./data
UPLOAD_DIR=./uploads
LOG_DIR=./logs
BACKUP_DIR=./backups